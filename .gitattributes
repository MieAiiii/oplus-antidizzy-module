# 统一换行符：shell 脚本必须是 LF，
# 否则 Android 上会出现 "#!/system/bin/sh^M: bad interpreter"
* text=auto eol=lf

*.sh    text eol=lf
*.prop  text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.py    text eol=lf
*.md    text eol=lf

# 二进制文件不做任何转换
*.apk   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jar   binary
*.keystore binary
